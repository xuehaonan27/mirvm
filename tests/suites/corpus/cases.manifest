#
# ---- real cargo projects (corpus/projects/<name>/, mode=diff: three-way comparison against native cargo run) ----
# vendor provenance and sha256 pins live in corpus/projects/README.md; {ROOT} = repo root absolute path
# (expanded by the shared harness; a relative path cannot name one file for both legs, whose cwd is the project dir).
hexyl                   full   180  diff             env=RUSTFLAGS=--cap-lints%20allow args=--color;never;-n;256;{ROOT}/tests/fixtures/hexyl_input.bin
tokei                   full   300  diff             env=RUSTFLAGS=--cap-lints%20allow args={ROOT}/tests/fixtures/tokei_input
