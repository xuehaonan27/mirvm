#
# ---- 真 cargo 项目（corpus/projects/<名>/，mode=diff：native cargo run 三维对拍）----
# vendor 来源与 sha256 钉见 corpus/projects/README.md；{ROOT} = 仓库根绝对路径
# （共享 harness 展开；两侧 cwd=项目目录下的相对路径无法同指一文件）。
hexyl                   full   180  diff             env=RUSTFLAGS=--cap-lints%20allow args=--color;never;-n;256;{ROOT}/tests/fixtures/hexyl_input.bin
tokei                   full   300  diff             env=RUSTFLAGS=--cap-lints%20allow args={ROOT}/tests/fixtures/tokei_input
