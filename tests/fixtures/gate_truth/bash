#!/bin/bash
set -u

script=${1:-}
echo "$script" >>"$GATE_CALL_LOG"
if [ "${GATE_FAIL_SUITE:-}" = "$script" ]; then
    echo "FAIL injected failure: $script"
    exit 1
fi

case "$script" in
    tests/suites/differential/cargo.sh)
        echo 'PASS ecosystem'
        echo 'PASS ffi_zlib'
        echo 'PASS ripgrep_regex'
        echo 'PASS warning_return'
        echo 'PASS project'
        echo '== differential.cargo: 5 passed, 0 skipped, 0 expected-failed, 0 failed =='
        ;;
    tests/suites/differential/programs.sh)
        echo '== differential.programs: 20 passed, 0 skipped, 0 expected-failed, 0 failed =='
        ;;
    tests/suites/runtime/semantics.sh)
        if [ -n "${SKIP_TSAN:-}" ]; then
            echo 'SKIP TSan（SKIP_TSAN=1）'
        else
            echo 'PASS TSan（含 tsan_mt 多线程真身，零警告）'
        fi
        echo '== runtime.semantics: 1 passed, 0 skipped, 0 expected-failed, 0 failed =='
        ;;
    tests/suites/runtime/x86_features.sh)
        for probe in addcarry xgetbv simd_insert simd_shift vzeroupper; do
            if [ "${M51_SKIP_PROBE:-}" = "$probe" ]; then
                echo "SKIP m51_$probe: host lacks required CPU feature"
            else
                echo "PASS m51_$probe"
            fi
        done
        for feature in pshufb sha; do
            if [ "${M51_SKIP_VECTOR_FEATURE:-}" = "$feature" ]; then
                echo "SKIP m51_x86_vectors/$feature: host lacks $feature"
            else
                echo "PASS m51_x86_vectors/$feature"
            fi
        done
        ;;
    tests/suites/performance/limits.sh)
        if [ -n "${SKIP_PERF:-}" ]; then
            echo 'SKIP 性能上限（SKIP_PERF=1；语义 gate 仍照常执行）'
        fi
        ;;
    tests/suites/quality/rust.sh|tests/suites/differential/cargoless.sh|\
    tests/suites/contracts/cargoless_test.sh|tests/suites/contracts/cargoless_workspace.sh|\
    tests/suites/contracts/cargoless_git.sh|tests/suites/contracts/cargoless_sources.sh|\
    tests/suites/contracts/pack.sh|tests/suites/contracts/build_script_rerun.sh|\
    tests/suites/contracts/deps_image.sh|tests/suites/corpus/contract.sh|\
    tests/suites/runtime/c_unwind.sh|tests/suites/runtime/jit_stats.sh|\
    tests/suites/harness/truth.sh)
        echo "PASS fake $script"
        ;;
    *)
        echo "unexpected nested suite: $script" >&2
        exit 99
        ;;
esac
