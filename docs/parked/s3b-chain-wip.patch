+/// 装载 image 栈（S3′b，m5.3-design §3.3）：底座（栈底）+ 依赖 image 链，**贪心前缀
+/// 装配**。规范序 = target-dep crate 按 stable_crate_id 排序（构建/装载两侧一致）；
+/// 逐 crate 计算"建于当前前缀"的期望文件，装载并三重校验（身份键 == 期望 + below_key
+/// == 前缀键 + 域 == 样条 k），命中即扩前缀、失配即跳过（该 crate 退 delta，绝不腐坏）。
+/// 依赖 DAG 宽度决定命中率（线性链无法表达非线性 DAG，兄弟依赖可能互斥——命中率实测，
+/// 见 m6-log；正确性与命中率解耦）。
+pub fn load_chain(tcx: TyCtxt<'_>) -> ImageStack {
+    if disabled() {
+        return ImageStack::empty();
+    }
+    let fp = session_fp(tcx);
+    let Some(stamp) = crate::sysroot::current_stamp_value() else {
+        return ImageStack::empty();
+    };
+    let spline = crate::vm::engine::frozen::IMAGE_SPLINE_BASE;
+    let mut images: Vec<BaseImage> = Vec::new();
+    // 栈底 = std 底座（建于空 ⇒ below_key 空）
+    if let Some(b) = ensure_base()
+        && b.lowering_fp == fp
+        && b.below_key.is_empty()
+    {
         images.push(b);
     }
+    // 依赖 image：**定点装载**——反复扫描全部 crate，任何 below_key == 当前前缀键的
+    // image 都装（一个 image 一旦其构建前缀被重装齐即可装），直到一轮零新增。比规范序
+    // 单趟命中率高（不受 crate_id 序与构建拓扑序错位之限）。并行构建下兄弟依赖仍可能
+    // 互斥（线性链无法表达非线性 DAG）——正确性由 below_key 精确匹配保证，命中率实测。
+    let mut ids: Vec<u64> = tcx
+        .crates(())
+        .iter()
+        .map(|&c| tcx.stable_crate_id(c).as_u64())
+        .collect();
+    ids.sort_unstable();
+    ids.dedup();
+    let mut remaining: Vec<u64> = ids;
+    loop {
+        let prefix_key = chain_key_of(&images);
+        let k = images.iter().filter(|i| i.domain >= spline).count();
+        let domain_k = crate::vm::engine::frozen::image_addr(k);
+        let mut added = false;
+        let mut i = 0;
+        while i < remaining.len() {
+            let crate_id = remaining[i];
+            let path = dep_image_path(&stamp, fp, crate_id, &prefix_key);
+            let hit = load(&path, &stamp).filter(|img| {
+                img.key == image_key(&stamp, fp, crate_id)
+                    && img.below_key == prefix_key
+                    && img.domain == domain_k
+                    && img.lowering_fp == fp
+            });
+            if let Some(img) = hit {
