+/// image 文件序列化 + 原子发布（std 底座与依赖 image 共用）。字节确定性：
+/// exports/fn_addrs（HashMap 随机迭代序）摘排序 Vec 落盘（module 内清空），装载端重建。
+fn write_image_file(
+    out: &std::path::Path,
+    crate_id: u64,
+    below_key: &str,
+    domain: u64,
+    fp: (bool, bool, bool),
+    stamp: &str,
+    module: &mut ir::Module,
+    exports: crate::lower::BaseExports,
+) -> bool {
+    let mut export_syms: Vec<(Box<str>, ir::FuncId)> = module.exports.drain().collect();
+    export_syms.sort_unstable();
+    let mut fn_addr_pairs: Vec<(u64, ir::FuncId)> = module.fn_addrs.drain().collect();
+    fn_addr_pairs.sort_unstable();
+    let mut fn_entry_syms = exports.fn_entry_syms;
+    fn_entry_syms.sort_unstable();
+    let mut static_syms = exports.static_syms;
+    static_syms.sort_unstable();
+    let mut tls_syms = exports.tls_syms;
+    tls_syms.sort_unstable();
+    let file = BaseFile {
+        build_id: env!("MIRVM_BUILD_ID").to_string(),
+        sysroot_stamp: stamp.to_string(),
+        lowering_fp: fp,
+        crate_id,
+        below_key: below_key.to_string(),
+        domain,
+        module: std::mem::take(module),
+        export_syms,
+        fn_addr_pairs,
+        fn_entry_syms,
+        static_syms,
+        tls_syms,
+    };
+    let Ok(bytes) = postcard::to_stdvec(&file) else {
+        return false;
+    };
+    let Some(dir) = out.parent() else {
+        return false;
+    };
+    if std::fs::create_dir_all(dir).is_err() {
+        return false;
+    }
+    let tmp = dir.join(format!(
+        ".{}.tmp-{}",
+        out.file_name().unwrap_or_default().to_string_lossy(),
+        std::process::id()
+    ));
+    if std::fs::write(&tmp, &bytes).is_err() || std::fs::rename(&tmp, out).is_err() {
+        let _ = std::fs::remove_file(&tmp);
+        return false;
+    }
+    true
+}
