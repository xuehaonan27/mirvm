+/// 依赖 image 成像（S3′b）：在依赖自己的 cargo 会话（DepCallbacks，-Zno-codegen，
+/// tcx 合法在场、无 guest 运行 ⇒ 快照天然洁净）就地降低本 crate mono 集减栈下。
+/// 最佳努力：一切失败静默跳过（该依赖退 delta；诊断不入 stderr——那是依赖诊断流）。
+pub fn build_dep_image(tcx: TyCtxt<'_>) {
+    let dbg = |m: &str| {
+        if std::env::var_os("MIRVM_IMAGE_DEBUG").is_some() {
+            use std::io::Write;
+            if let Ok(mut f) = std::fs::OpenOptions::new()
+                .create(true)
+                .append(true)
+                .open(base_dir().join("image.log"))
+            {
+                let _ = writeln!(f, "{m}");
+            }
+        }
+    };
+    if disabled() {
+        return;
+    }
+    let crate_name = tcx.crate_name(rustc_hir::def_id::LOCAL_CRATE);
+    // 关键（S3′b 根因）：cargo 流水线的 metadata-only 趟 should_codegen()=false ⇒
+    // reachable_non_generics 空（symbol_export.rs:53）⇒ lib 自身非泛型函数不成为 mono
+    // root（Lazy 策略）⇒ 只收到 core 泛型实例（已在底座）⇒ 空 image。必须门控在
+    // should_codegen()=true 的 link 趟成像——那趟的 mono 集 = native 给 rlib codegen 的集。
+    if !tcx.sess.opts.output_types.should_codegen() {
+        dbg(&format!("dep-image: {crate_name} should_codegen=false（metadata 趟），跳过"));
+        return;
+    }
+    let Some(stamp) = crate::sysroot::current_stamp_value() else {
+        dbg("dep-image: 无 sysroot stamp");
+        return;
+    };
+    let fp = session_fp(tcx);
+    let stack = load_chain(tcx); // 本依赖的上游 image 链
+    let crate_id = tcx
+        .stable_crate_id(rustc_hir::def_id::LOCAL_CRATE)
+        .as_u64();
+    let prefix_key = stack.chain_key();
+    let path = dep_image_path(&stamp, fp, crate_id, &prefix_key);
+    if path.exists() {
+        dbg(&format!("dep-image: {crate_name} 已存在，跳过"));
+        return; // 已成像（跨运行/项目复用）
+    }
+    let k = stack.dep_count();
+    let domain = crate::vm::engine::frozen::image_addr(k);
+    dbg(&format!(
+        "dep-image: {crate_name} collect={} 个 mono item",
+        crate::lower::collect::collect(tcx).len()
+    ));
+    let (mut module, exports) = crate::lower::lower_for_image_build(tcx, &stack, k);
+    // 三判据（同底座）：冻结区落声明域 + 无宿主地址直嵌（environ 类依赖不成像退 delta）
+    let frozen_ok = module
+        .frozen
+        .as_ref()
+        .is_some_and(|fr| fr.at_fixed_base() && fr.home() == domain);
+    if !frozen_ok {
+        dbg(&format!(
+            "dep-image: {crate_name} 冻结区未落域 {domain:#x}（栈 dep={k}）"
+        ));
+        return;
+    }
+    if !module.foreign_static_syms.is_empty() {
+        dbg(&format!(
+            "dep-image: {crate_name} 宿主地址直嵌 {:?}，退 delta",
+            module.foreign_static_syms
+        ));
+        return;
+    }
+    let ok = write_image_file(
+        &path,
+        crate_id,
+        &prefix_key,
+        domain as u64,
+        fp,
+        &stamp,
+        &mut module,
+        exports,
+    );
+    dbg(&format!(
+        "dep-image: {crate_name} 成像={ok}（fns={}，栈 dep={k}，域={domain:#x}）",
+        module.funcs.len()
+    ));
+}
